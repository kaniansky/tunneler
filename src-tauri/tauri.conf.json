{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tunneler Online",
  "mainBinaryName": "tunneler-online",
  "version": "../package.json",
  "identifier": "io.github.kaniansky.tunneler-online",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "windows": [
      {
        "title": "Tunneler Online",
        "width": 1000,
        "height": 760,
        "minWidth": 400,
        "minHeight": 320,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "dmg",
      "app"
    ],
    "category": "ArcadeGame",
    "shortDescription": "TUNNELER (1991) in a window, with online play",
    "longDescription": "TUNNELER 2.0 (1991, Geoffrey Silverton) rewritten in JavaScript: split screen, versus the computer and online play on a Tunneler Online server.",
    "copyright": "Public domain (Unlicense); GNU Unifont glyphs under SIL OFL 1.1 / GPL 2+",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    }
  }
}
