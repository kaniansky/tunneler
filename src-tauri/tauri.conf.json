{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tunneler",
  "mainBinaryName": "tunneler",
  "version": "../package.json",
  "identifier": "com.kaniansky.Tunneler",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "windows": [
      {
        "title": "Tunneler",
        "width": 1000,
        "height": 760,
        "minWidth": 400,
        "minHeight": 320,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "rpm",
      "appimage",
      "dmg",
      "app"
    ],
    "category": "ArcadeGame",
    "linux": {
      "deb": {
        "provides": ["tunneler-online"],
        "conflicts": ["tunneler-online"],
        "replaces": ["tunneler-online"]
      },
      "rpm": {
        "obsoletes": ["tunneler-online"]
      }
    },
    "shortDescription": "TUNNELER (1991) in a window, with online play",
    "longDescription": "TUNNELER 2.0 (1991, Geoffrey Silverton) rewritten in JavaScript: split screen, versus the computer and online play on a Tunneler server.",
    "copyright": "Public domain (Unlicense); GNU Unifont glyphs under SIL OFL 1.1 / GPL 2+",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQwNzY3OTI5REY2OUFCM0IKUldRN3EybmZLWGwyMEFnc3YvbFc4WUJ4ZkRCMWVkRVhnb0RKRUE4aU8wY0VORHl5THdNUjU4blcK",
      "endpoints": [
        "https://github.com/kaniansky/tunneler/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
