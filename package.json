{
  "name": "tunneler",
  "version": "1.3.1",
  "description": "TUNNELER 2.0 (1991, Geoffrey Silverton) rewritten in JavaScript from the decompiled original: split screen, vs computer and online multiplayer in the browser",
  "license": "Unlicense",
  "author": "Norko Kaniansky",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaniansky/tunneler.git"
  },
  "homepage": "https://github.com/kaniansky/tunneler#readme",
  "bugs": {
    "url": "https://github.com/kaniansky/tunneler/issues"
  },
  "engines": {
    "node": ">=20.19"
  },
  "private": true,
  "main": "server.js",
  "scripts": {
    "build": "node build.js",
    "version": "node tools/flatpak-update.js --metainfo $npm_package_version && git add flatpak/",
    "watch": "node build.js --watch",
    "start": "node server.js",
    "test": "node test/run.js",
    "test:engine": "node test/compare-wasm.js",
    "test:ext": "node test/ext-sim.js quick",
    "test:time": "node test/time-sim.js",
    "test:ai": "node test/ai-sim.js quick && node test/ai-ext-sim.js quick",
    "test:modes": "node test/modes-check.js",
    "test:net": "node test/net-sim.js && node test/quickplay-sim.js && node test/endpoint-check.js && node test/net-page-smoke.js",
    "test:lang": "node test/lang-check.js && node test/unicode-check.js",
    "test:local": "node test/local-check.js && node test/app-check.js",
    "test:input": "node test/input-check.js",
    "test:sound": "node test/sound-check.js",
    "test:serial": "node test/run.js --serial",
    "check:phone": "node build.js && node tools/phone-check.js"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
